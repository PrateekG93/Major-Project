# ============================================================
# Intelligent Academic & Career Copilot - .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.pyo

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/
.conda/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
*.cover
.tox/

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Data (generated/user-uploaded, large files) ---
data/copilot_app.db
data/vector_store/chroma/
data/raw_documents/*.pdf
data/processed_chunks/*.json

# Keep directory structure with .gitkeep
!data/vector_store/.gitkeep
!data/processed_chunks/.gitkeep
!data/raw_documents/.gitkeep

# --- ML Models (binary, can be regenerated) ---
models/scoring_model.joblib
*.joblib
*.pkl
*.h5
*.pt
*.pth
*.onnx

# Keep directory structure with .gitkeep
!models/.gitkeep

# --- Node / Frontend (if applicable) ---
node_modules/

# --- Misc ---
*.log
*.tmp
*.bak
*.swp
