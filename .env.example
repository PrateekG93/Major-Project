# ============================================================
# Intelligent Academic & Career Copilot - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Core Configuration ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# --- Model & LLM Settings ---
LLM_PROVIDER=groq                     # Options: 'groq', 'huggingface', 'ollama'
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Hugging Face (Alternative)
HF_API_TOKEN=hf_your_free_token_here
PRIMARY_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
FALLBACK_LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage & Vector DB ---
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIR=./data/vector_store/chroma
SQLITE_DB_PATH=./data/copilot_app.db

# --- Interview Settings ---
QUESTION_BANK_PATH=./data/question_bank/questions.json

# --- Evaluation ---
ENABLE_RAGAS_EVAL=True

# --- Authentication & Email OTP ---
# 'console' (prints 6-digit code in backend terminal) or 'email' (real SMTP email delivery)
OTP_MODE=console
LOGIN_REQUIRE_OTP=true
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5
OTP_HMAC_SECRET=change_this_to_a_long_random_secret_in_production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Academic & Career Copilot

# --- Admin Portal ---
ADMIN_EMAIL=admin@copilot.com
ADMIN_PASSWORD=admin123

# --- Dynamic Question Bank & Source Adapters ---
SCRAPE_ENABLED=True
SCRAPE_RATE_LIMIT_SECONDS=3

# --- Audio Interview & Speech-to-Text (BeFluent Engine) ---
STT_MODEL=whisper-large-v3-turbo
AUDIO_STORAGE_DIR=./data/audio_recordings
AUDIO_RETENTION_HOURS=24
