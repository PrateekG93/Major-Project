# ============================================================
# Intelligent Academic & Career Copilot - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Core Configuration ---
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# --- Model & LLM Settings ---
LLM_PROVIDER=groq                     # Options: 'groq', 'huggingface', 'ollama'
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Hugging Face (Alternative)
HF_API_TOKEN=hf_your_free_token_here
PRIMARY_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
FALLBACK_LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage & Vector DB ---
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIR=./data/vector_store/chroma
SQLITE_DB_PATH=./data/copilot_app.db

# --- ML Scoring ---
SCORING_MODEL_PATH=./models/scoring_model.joblib
WEAKNESS_THRESHOLD=0.70

# --- Interview Settings ---
QUESTIONS_PER_SESSION=10
QUESTION_BANK_PATH=./data/question_bank/questions.json

# --- Evaluation ---
ENABLE_RAGAS_EVAL=True

# --- Authentication & OTP ---
# 'console' (prints 6-digit code in terminal) or 'email' (sends real email via SMTP)
OTP_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Admin Portal ---
ADMIN_EMAIL=admin@copilot.com
ADMIN_PASSWORD=admin123
